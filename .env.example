# Oriel local / self-host environment
# Copy to `.env` and replace every CHANGE_ME value. Never commit real secrets.

NODE_ENV=development
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
SANDBOX_ORIGIN=http://127.0.0.1:3001
NEXT_PUBLIC_SANDBOX_ORIGIN=http://127.0.0.1:3001
SANDBOX_PORT=3001

DATABASE_URL=postgres://oriel:oriel_dev_password@127.0.0.1:5432/oriel
REDIS_URL=redis://127.0.0.1:6379

# better-auth session signing. Generate with: openssl rand -base64 32
AUTH_SECRET=CHANGE_ME_AUTH_SECRET_32CHARS_MIN

# AES-256-GCM wrapping key for user BYOK credentials. Generate with: openssl rand -hex 32
ENCRYPTION_KEY=CHANGE_ME_ENCRYPTION_KEY_MUST_BE_AT_LEAST_32_CHARS

STORAGE_ENDPOINT=http://127.0.0.1:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=oriel
STORAGE_ACCESS_KEY=oriel
STORAGE_SECRET_KEY=oriel_dev_password
STORAGE_FORCE_PATH_STYLE=true
PUBLIC_STORAGE_URL=http://127.0.0.1:9000/oriel

# OpenAI-compatible provider. Leave empty to serve seed/editorial content only.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
AI_FAST_MODEL=gpt-4.1-nano
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_MODERATION_MODEL=omni-moderation-latest
AI_TRANSCRIPTION_BASE_URL=
AI_TRANSCRIPTION_API_KEY=
AI_TRANSCRIPTION_MODEL=whisper-1
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_CONCURRENCY=4
AI_CONTEXT_WINDOW=32000
AI_SUPPORTS_JSON_SCHEMA=true
AI_PROVIDER_NAME=openai-compatible
AI_DAILY_TOKEN_BUDGET=250000

MODERATION_MODE=standard
SCANNER_MODE=stub
CLAMAV_HOST=
CLAMAV_PORT=3310

RATE_LIMIT_ANON_PER_MIN=60
RATE_LIMIT_USER_PER_MIN=180

ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=CHANGE_ME_admin_password_12
ADMIN_BOOTSTRAP_HANDLE=oriel-admin

LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Oriel <noreply@localhost>

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

FEATURE_COMMENTS=false
